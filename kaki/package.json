{
  "name": "kaki",
  "version": "0.9.0",
  "private": true,
  "description": "A self-hosted household agent for Southeast Asia",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "eslint . && pnpm --filter @kaki/control-ui lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:qa": "node --test tests/qa/*.test.mjs",
    "test:e2e": "node scripts/qa/validate-fixtures.mjs && node scripts/qa/replay-fixtures.mjs && pnpm -r --if-present test:e2e",
    "evals": "node scripts/qa/locale-score.mjs --dir evals/locales --out evals/results/locale-summary.json",
    "security:scan": "node scripts/qa/secrets-scan.mjs",
    "docs:check": "node scripts/qa/check-doc-links.mjs",
    "acceptance": "node scripts/qa/acceptance-report.mjs",
    "acceptance:release": "node scripts/qa/acceptance-report.mjs --release",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:qa && pnpm test:e2e && pnpm evals && pnpm security:scan && pnpm acceptance",
    "kaki": "tsx scripts/kaki.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}
